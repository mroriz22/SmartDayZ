# Copie para .env (cp .env.example .env) e preencha. Nunca commite valores reais.
# Cada chave tem uma linha dizendo pra que serve e se é [obrigatória] ou [opcional].

# ── App / identidade na fábrica ──
# [opcional] Nome exibido no app, título e metadados (default "SmartDayZ" no layout).
APP_NAME=SmartDayZ
# [opcional] Slug do SaaS na fábrica / control plane (default "saas-template").
SAAS_SLUG=smartdayz
# [opcional] Ambiente: development | test | production (o Next define sozinho).
NODE_ENV=development
# [opcional] Dias de trial dados no signup (default 7).
TRIAL_DAYS=7
# [opcional] Prefixos de rota atrás do paywall, separados por vírgula (default /dashboard,/app).
PAYWALL_PREFIXES=/dashboard,/app
# [opcional] Origens extras liberadas no next dev, separadas por vírgula (ex.: IP da rede local).
# NEXT_ALLOWED_DEV_ORIGINS=192.168.0.10

# ── Auth (Better Auth) ──
# [obrigatória] URL pública do app, usada como baseURL e trusted origin do auth.
BETTER_AUTH_URL=http://localhost:3000
# [obrigatória] Segredo de sessão, mínimo 16 chars — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-secret-longo-de-pelo-menos-32-chars

# ── Postgres (1 database por SaaS na VPS compartilhada) ──
# [obrigatória] Connection string do Postgres (app, drizzle e /api/product/setup).
DATABASE_URL=postgres://saas:saas@127.0.0.1:5435/smartdayz
# [opcional] Token do header x-setup-token que libera POST /api/product/setup; vazio = endpoint desligado.
SETUP_TOKEN=

# ── Redis ──
# [opcional] URL do Redis (default redis://127.0.0.1:6379).
REDIS_URL=redis://127.0.0.1:6380
# [opcional] Prefixo das chaves no Redis compartilhado (default "saas:").
REDIS_PREFIX=smartdayz:

# ── Quack Checkout ──
# [obrigatória em produção] Segredo do webhook da Quack (whsec_...) que valida POST /api/webhooks/quack.
QUACK_WEBHOOK_SECRET=
# [opcional] Product ID principal da Quack neste SaaS (pode ficar vazio no bootstrap).
QUACK_PRODUCT_ID=
# [obrigatória em produção] Link estável do checkout (produto ou offer) usado no CTA do paywall.
QUACK_CHECKOUT_URL=
# [opcional] Espelho client-side do checkout, só se um componente no browser precisar (mesmo valor).
# NEXT_PUBLIC_QUACK_CHECKOUT_URL=

# ── IA ──
# [opcional] Chave da API Gemini usada em /api/product/ai; vazia = recurso de IA desligado.
GEMINI_API_KEY=
# [opcional] Modelo Gemini usado em /api/product/ai (default gemini-2.0-flash).
AI_MODEL=gemini-2.0-flash

# ── Medição de anúncio e verificação de domínio ──
# Todas, menos META_CAPI_TOKEN, são de BUILD: o Next grava no HTML na hora do `next build`
# (no Coolify, marcar como "Build Variable"; o Dockerfile já tem o ARG). Vazias = nada é carregado.
# [opcional] ID do pixel (conjunto de dados) da Meta; liga o pixel nas páginas públicas.
NEXT_PUBLIC_META_PIXEL_ID=
# [opcional] ID da tag do Google Analytics 4 (G-...); liga a tag nas páginas públicas.
NEXT_PUBLIC_GOOGLE_TAG_ID=
# [opcional] Conversão de cadastro do Google Ads (AW-.../...); só se houver campanha no Google Ads.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSAO_CADASTRO=
# [opcional] Código do Search Console; vira <meta name="google-site-verification">.
GOOGLE_SITE_VERIFICATION=
# [opcional] Código de verificação de domínio da Meta; vira <meta name="facebook-domain-verification">.
META_DOMAIN_VERIFICATION=
# [opcional] Token da API de Conversões da Meta (Gerenciador de Eventos > Configurações do
# pixel > Gerar token). De RUNTIME, é segredo: só no servidor, nunca NEXT_PUBLIC_. Com ele e o
# NEXT_PUBLIC_META_PIXEL_ID, o webhook da Quack avisa a Meta de cada venda nova (Purchase).
META_CAPI_TOKEN=

# ── Control plane (admin multi-SaaS) ──
# [opcional] URL do saas-control que recebe os eventos de analytics; vazio = não envia.
FACTORY_CONTROL_URL=http://localhost:3100
# [opcional] Chave de ingest, a mesma configurada no saas-control como INGEST_KEYS.
FACTORY_INGEST_KEY=dev-ingest-key-change-me

# ── Smoke E2E (scripts/e2e-smoke.mjs, só local/CI) ──
# [opcional] URL base alvo do smoke; tem prioridade sobre E2E_PORT.
# BASE=https://smartdayz.com
# [opcional] Porta local do smoke quando BASE está vazio (default 3000).
E2E_PORT=3000
